# Copy to .claude/.env and fill in real values.
# .claude/.env is auto-loaded by every hook + .claude/scripts/notifier-send.sh.
# NEVER commit .claude/.env — it is gitignored. Secrets live here only.

# ---------------------------------------------------------------------------
# Notifier channel (abstraction in .claude/scripts/notifier-send.sh)
# ---------------------------------------------------------------------------
# Which push channel the hooks use. Default: telegram.
# Swap to a different channel by adding a send_<name>() driver to
# notifier-send.sh and setting it here. "noop" disables all pushes.
NOTIFIER_CHANNEL=telegram

# Per-file byte cap for attachments (default 50 MB — Telegram Bot API limit).
# NOTIFIER_FILE_LIMIT=52428800

# ---------------------------------------------------------------------------
# Telegram driver (used when NOTIFIER_CHANNEL=telegram)
# ---------------------------------------------------------------------------
# Get from @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=

# Your Telegram chat/user ID. Quick way: message your bot, then visit
# https://api.telegram.org/bot<TOKEN>/getUpdates and copy `chat.id`.
TELEGRAM_CHAT_ID=

# Optional: 1 = silent message (no sound on phone). Default 0.
TELEGRAM_NOTIFY_SILENT=0

# Optional: seconds between file sends (stay under ~1 msg/sec per chat). Default 0.4.
# TELEGRAM_SEND_DELAY=0.4

# ---------------------------------------------------------------------------
# Context monitor (.claude/hooks/context-monitor.sh)
# ---------------------------------------------------------------------------
# Match this to your model's actual context window so the % is meaningful.
# Default 1000000 (1M tier). Use 200000 for the legacy 200K tier.
CONTEXT_WINDOW_TOKENS=1000000

# Optional: 1 = suppress every context warning. Default 0.
CONTEXT_WARN_DISABLE=0
