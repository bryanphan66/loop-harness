# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app?schema=public

# --- API ---
API_PORT=3001
CORS_ORIGIN=http://localhost:3000
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Seed admin (created by `pnpm db:seed`) ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin1234
SEED_ADMIN_NAME=Admin

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Tier-2 (opt-in): queue + object storage — only needed by a project with
# an async-job/media-pipeline/storage/external-integration phase. `docker
# compose --profile tier2 up -d` starts redis for local dev. ---
REDIS_URL=redis://localhost:6379
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.storage-local
# STORAGE_DRIVER=s3 (AWS S3 or an S3-compatible endpoint, e.g. Cloudflare R2):
# STORAGE_S3_BUCKET=
# STORAGE_S3_REGION=auto
# STORAGE_S3_ENDPOINT=
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=
# STORAGE_S3_FORCE_PATH_STYLE=true
