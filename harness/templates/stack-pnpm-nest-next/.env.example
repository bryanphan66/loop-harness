# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app?schema=public

# --- API ---
API_PORT=3001
CORS_ORIGIN=http://localhost:3000
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Seed admin (created by `pnpm db:seed`) ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin1234
SEED_ADMIN_NAME=Admin

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Tier-2 (opt-in): queue + object storage — only needed by a project with
# an async-job/media-pipeline/storage/external-integration phase. `docker
# compose --profile tier2 up -d` starts redis + a local MinIO (S3-compatible,
# console at http://localhost:9001) for local dev. ---
REDIS_URL=redis://localhost:6379
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.storage-local
# STORAGE_DRIVER=s3 exercises the real signed-URL/entitlement AC path (object-
# storage / media-pipeline playbooks) against the tier2 MinIO container below;
# swap the endpoint for Cloudflare R2 or AWS S3 in staging/prod — same driver,
# no code change. `n/a` for STORAGE_DRIVER=local (no signed-URL expiry there).
# STORAGE_S3_BUCKET=app-media
# STORAGE_S3_REGION=auto
# STORAGE_S3_ENDPOINT=http://localhost:9000
# STORAGE_S3_ACCESS_KEY_ID=minioadmin
# STORAGE_S3_SECRET_ACCESS_KEY=minioadmin123
# STORAGE_S3_FORCE_PATH_STYLE=true
