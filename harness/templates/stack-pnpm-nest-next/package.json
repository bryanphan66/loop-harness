{
  "name": "__PROJECT_SLUG__",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:api": "pnpm --filter ./apps/api dev",
    "dev:web": "pnpm --filter ./apps/web dev",
    "dev:worker": "pnpm --filter ./apps/worker dev:watch",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "e2e": "pnpm --filter ./apps/web e2e",
    "db:migrate": "pnpm --filter ./apps/api db:migrate",
    "db:seed": "pnpm --filter ./apps/api db:seed",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.0",
    "prettier": "^3.5.0",
    "typescript-eslint": "^8.24.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix --no-warn-ignored",
    "*.{json,md,css,mjs}": "prettier --write"
  }
}
